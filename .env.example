# Copy these into your hosting provider's environment settings
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# docker | local | auto  (auto = Docker if available, otherwise local dev fallback)
SANDBOX_MODE=auto
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MAX_CONCURRENT=4
# 0 = do not create the demo manager/developer accounts
SEED_DEMO=1
